@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "Layout.cshtml";

	// Phase 1: placeholder data so the design can be checked. Phase 2 turns these into editable content.
	var events = new[] {
		(Day: "11", Month: "NOV", Tag: "Workshop", Title: "Global ECD Convening"),
		(Day: "12", Month: "NOV", Tag: "Conference", Title: "Global ECD Convening"),
		(Day: "13", Month: "NOV", Tag: "Parenting session", Title: "Children and Parents Tours")
	};
	var news = new[] {
		(Tag: "Press release", Title: "Khalifa for Children's Storytelling Creativity"),
		(Tag: "Political", Title: "ECA launches their Early Years Matter campaign"),
		(Tag: "News", Title: "Promoting active play through the third annual WED Fun Run")
	};
	var blurb = "Leaders and practitioners gather to align cross-sectoral strategies for scaling early childhood development impact.";
}

<!-- Content blocks (Hero etc.), edited in the backoffice -->
@await Html.GetBlockListHtmlAsync(Model.Value<Umbraco.Cms.Core.Models.Blocks.BlockListModel>("contentBlocks"))

<!-- About -->
<section class="section">
	<div class="container about">
		<div>
			<span class="eyebrow c-pink">About</span>
			<h2 class="display-lg">Early Childhood Week</h2>
			<div><p>@Model.BodyText</p></div>
			<a href="#" class="btn btn-yellow">Explore the week</a>
		</div>
		<div class="photo"></div>
	</div>
</section>

<!-- Family resources -->
<section class="section resources">
	<div class="container about">
		<div>
			<h3>Every moment matters</h3>
			<h2 class="display-lg">Family resources</h2>
			<p>Make everyday moments count. Discover practical tools, playful ideas and trusted resources designed to help families connect, learn and grow together.</p>
			<a href="#" class="btn btn-pink">Explore resources</a>
		</div>
		<div class="photo"></div>
	</div>
</section>

<!-- Featured events -->
<section class="section bg-neutral">
	<div class="container">
		<div class="section-head">
			<div><span class="eyebrow">Featured</span><h2 class="display-lg c-green">Events</h2></div>
			<p>Discover exciting events and experiences bringing families and communities together across the UAE.</p>
			<a href="#" class="btn btn-green">View all events</a>
		</div>
		<div class="cards">
			@foreach (var e in events)
			{
				<article class="card">
					<div class="thumb"><div class="date">@e.Day<small>@e.Month</small></div></div>
					<span class="tag">@e.Tag</span>
					<h4>@e.Title</h4>
					<p>@blurb</p>
					<a href="#" class="btn btn-green">View event</a>
				</article>
			}
		</div>
	</div>
</section>

<!-- Featured partners -->
<section class="section">
	<div class="container">
		<div class="partners-head">
			<span class="eyebrow c-pink" style="opacity:.6">Early Childhood Week</span>
			<h2 class="display-lg c-pink">Featured partners</h2>
			<p>Together with our partners, we're creating meaningful experiences that support children, strengthen families and bring communities together across the UAE.</p>
		</div>
		<div class="logos-row"><span>Higher Colleges</span><span>Tiny Miners</span><span>KFG</span><span>Linea Education</span><span>Zahret Al Lotus</span></div>
		<div class="center"><a href="#" class="btn btn-pink">View all partners</a></div>
	</div>
</section>

<!-- Featured news -->
<section class="section bg-neutral">
	<div class="container">
		<div class="section-head">
			<div><span class="eyebrow">Featured</span><h2 class="display-lg c-blue">News</h2></div>
			<p>Stay connected with the latest stories, announcements and highlights from Early Childhood Week across the UAE.</p>
			<a href="#" class="btn btn-blue">View all news</a>
		</div>
		<div class="cards">
			@foreach (var n in news)
			{
				<article class="card">
					<div class="thumb"></div>
					<span class="tag">@n.Tag</span>
					<h4>@n.Title</h4>
					<p>@blurb</p>
					<a href="#" class="btn btn-blue">Read more</a>
				</article>
			}
		</div>
	</div>
</section>
