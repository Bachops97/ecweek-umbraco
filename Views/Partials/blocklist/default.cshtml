@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListModel>
@{
	if (Model?.Any() != true) { return; }

	// All Hero blocks form ONE carousel (slides), shown where the first Hero block sits.
	// Every other block renders on its own, in the order the editor arranged them.
	var heroSlides = Model.Where(b => b?.ContentKey != null && b.Content.ContentType.Alias == "heroBlock").ToList();
	var carouselShown = false;
}

<div class="umb-block-list">
	@foreach (var block in Model)
	{
		if (block?.ContentKey == null) { continue; }

		if (block.Content.ContentType.Alias == "heroBlock")
		{
			if (!carouselShown)
			{
				@await Html.PartialAsync("blocklist/_heroCarousel", heroSlides)
				carouselShown = true;
			}
			continue;
		}

		@await Html.PartialAsync("blocklist/Components/" + block.Content.ContentType.Alias, block)
	}
</div>
