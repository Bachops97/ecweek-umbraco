@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using Umbraco.Cms.Core.Models
@{
	Layout = "Layout.cshtml";
	string S(string a) => Model.Value<string>(a) ?? "";
	string[] Lines(string a) => S(a).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
	var img = Model.Value<MediaWithCrops>("thumbnail");
	var map = Model.Value<MediaWithCrops>("mapImage");
	var logos = Model.Value<IEnumerable<MediaWithCrops>>("partnerLogos") ?? Enumerable.Empty<MediaWithCrops>();
	var start = Model.Value<DateTime>("startDate");
	var when = start > DateTime.MinValue ? start.ToString("d MMMM yyyy", CultureInfo.InvariantCulture) + (S("timeText") != "" ? " | " + S("timeText") : "") : S("timeText");
	var cat = Lines("tags").FirstOrDefault() ?? S("eventType");
	string MapUrl() => "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(S("location") != "" ? S("location") : Model.Name);
	string Link(string v) => string.IsNullOrWhiteSpace(v) || v.Trim() == "#" ? MapUrl() : v;
	ViewData["bg"] = "yellow"; ViewData["h1"] = "You might be"; ViewData["h2"] = "interested in"; ViewData["horizontal"] = false;
}

<article class="detail event-detail bg-cream">
	<div class="container">
		<nav class="crumbs dark" aria-label="Breadcrumb"><a href="/">Home</a><span>&rsaquo;</span><a href="@Model.Parent?.Url()">@(Model.Parent?.Name)</a><span>&rsaquo;</span><span class="current">@Model.Name</span></nav>
		<div class="detail-grid">
			<div class="detail-main">
				@if (!string.IsNullOrWhiteSpace(cat)) { <span class="tag">@cat</span> }
				<h1 class="display-lg">@Model.Name</h1>
				@if (img != null) { <div class="detail-photo clip" style="background-image:url('@img.Url()')"></div> }
				@if (Lines("tags").Length > 0) { <div class="tag-row">@foreach (var t in Lines("tags")) { <span class="tag">@t</span> }</div> }
				<h2 class="sub-h"><span class="tc-black">About</span><br /><span class="tc-green">This event</span></h2>
				@foreach (var p in Lines("about")) { <p class="body">@p</p> }

				@if (S("directionsHeading") != "")
				{
					<h2 class="sub-h"><span class="tc-black">Location &amp;</span><br /><span class="tc-green">Direction</span></h2>
					<div class="map-card">
						<div class="map-img" style="@(map != null ? Html.Raw($"background-image:url('{map.Url()}')") : Html.Raw(""))"></div>
						<div class="map-info">
							<h3>@S("directionsHeading")</h3>
							<p>@S("directionsText")</p>
							<a class="btn btn-green" href="@Link(S("directionsLink"))" target="_blank" rel="noopener">Get directions</a>
						</div>
					</div>
				}
			</div>
			<aside class="detail-side">
				<div class="info-panel">
					@if (when != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "calendar")</span><div><h4>Date &amp; time</h4><p>@when</p></div></div> }
					@if (S("location") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "pin")</span><div><h4>Location</h4><p>@S("location")</p><a class="link" href="@Link(S("mapLink"))" target="_blank" rel="noopener">View on Map &rarr;</a></div></div> }
					@if (S("ageRange") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "people")</span><div><h4>Age range</h4><p>@S("ageRange")</p></div></div> }
					@if (S("accessibility") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "access")</span><div><h4>Accessibility</h4><p>@S("accessibility")</p></div></div> }
					@if (S("targetAudience") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "target")</span><div><h4>Target audience</h4><p>@S("targetAudience")</p></div></div> }
					@if (logos.Any()) { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "handshake")</span><div><h4>Partners</h4><div class="card-logos">@foreach (var l in logos) { <img src="@l.Url()" alt="" /> }</div></div></div> }
					@if (S("admission") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "ticket")</span><div><h4>Admission</h4><p>@S("admission")</p></div></div> }
					<a class="btn btn-green full" href="@(S("registerLink") is "" or "#" ? "#popup-register" : S("registerLink"))">Register now</a>
				</div>
				@if (S("phone") != "" || S("email") != "")
				{
					<div class="info-panel">
						@if (S("phone") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "phone")</span><div><h4>Phone number</h4><p>@S("phone")</p></div></div> }
						@if (S("email") != "") { <div class="info-row"><span class="ic">@await Html.PartialAsync("Icon", "mail")</span><div><h4>Email address</h4><p><a class="link" href="mailto:@S("email")">@S("email")</a></p></div></div> }
					</div>
				}
			</aside>
		</div>
	</div>
</article>

@{
	var regCtx = new Dictionary<string, string> { ["eventName"] = Model.Name, ["eventDate"] = when, ["eventLocation"] = S("location"), ["eventUrl"] = Context.Request.Scheme + "://" + Context.Request.Host + Model.Url() };
}
@await Html.PartialAsync("FormDialog", new MyProject.Forms.FormDialogModel("register", "register", "Register for " + Model.Name, "Tell us who is coming and we will send you a confirmation by email.", "Register now", "Thank you for registering! A confirmation is on its way to your inbox.", regCtx))

@await Html.PartialAsync("Related", Model)
