@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "Layout.cshtml";
	var kind = (Model.Value<string>("listing") ?? "events").Trim().ToLowerInvariant();
}

@await Html.GetBlockListHtmlAsync(Model.Value<Umbraco.Cms.Core.Models.Blocks.BlockListModel>("contentBlocks"))

@await Html.PartialAsync("Listings/" + kind, Model)
